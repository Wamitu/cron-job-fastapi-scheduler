ENV=development
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DATABASE_URL=driver://user:password@host:port/database
redis_client = redis.Redis(host="Redis", port=6379, db=2, decode_responses=True)

SMTP_SERVER={{email util}}
SMTP_PORT={{email driver port}}
EMAIL_USER={{email}}
EMAIL_PASSWORD={{email password}}
DEFAULT_USER_PASSWORD={{default user password}}

